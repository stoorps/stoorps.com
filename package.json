{
  "name": "stoorps",
  "private": true,
  "type": "module",
  "scripts": {
    "models:generate": "node src/tools/generate-models.mjs",
    "wasm:build": "node src/tools/build-wasm.mjs",
    "predev": "npm run models:generate && npm run previews:generate",
    "dev": "vite --host 127.0.0.1",
    "build": "node src/tools/generate-models.mjs && npm run previews:generate && node src/tools/package-source.mjs && vite build && node src/tools/verify-static.mjs",
    "test": "node src/tests/wasm.mjs",
    "test:bilresa": "node src/tests/bilresa-wasm.mjs",
    "pretypecheck": "npm run models:generate",
    "typecheck": "tsc --noEmit",
    "test:site": "node src/tools/generate-models.mjs && tsx --test src/tests/site.test.ts src/tests/catalog.test.mjs src/tests/previews.test.mjs",
    "preview:static": "python3 -m http.server 4174 --bind 127.0.0.1 --directory dist/client",
    "dev:tests": "vite --config src/tools/vite.tests.config.ts",
    "test:all": "npm run test:site && npm test && npm run test:bilresa && npm run test:lampshade",
    "previews:generate": "node src/tools/generate-previews.mjs",
    "test:lampshade": "node --test src/tests/lampshade.test.mjs"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.36",
    "@tanstack/react-start": "1.168.54",
    "fflate": "0.8.3",
    "manifold-3d": "3.5.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.183.2"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "5.2.0",
    "prettier": "3.9.6",
    "smol-toml": "1.8.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "7.3.6"
  }
}
